{
  "name": "kevrai-omni",
  "productName": "Kevrai Omni",
  "version": "3.0.0",
  "description": "Kevrai Omni — one-click local AI workstation (LLM/TTS/Image/Video/3D/Audio/Super-Resolution). MiniMax-Music3 music generation, LTX-2.5 video, super search, llama.cpp + MNN dual engine, hardware-aware recommendation.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ELECTRON_ENABLE_LOGGING=1 electron . --enable-logging --devtools",
    "test:python": "cd python && python -m pytest -q tests/",
    "test:js": "for f in electron/*.js renderer/*.js renderer/modules/*.js; do node --check \"$f\" || exit 1; done && echo \"JS syntax OK ($(ls electron/*.js renderer/*.js renderer/modules/*.js | wc -l) files)\"",
    "test:renderer": "node --test renderer/__tests__/*.test.js",
    "smoke": "bash scripts/smoke.sh",
    "test:smoke": "bash scripts/smoke.sh",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "release": "bash scripts/release.sh"
  },
  "author": {
    "name": "Kevrai Omni contributors",
    "email": "kevrai@local"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Bullobis/kevrai-omni",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bullobis/kevrai-omni.git"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
