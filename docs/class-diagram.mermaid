classDiagram
    class SourceProbe {
        +str url
        +str host
        +bool ok
        +float latency_ms
        +float speed_mbps
        +int status
        +int size_bytes
        +str error
        +str source_id  [新增]
        +str source_type  [新增]
        +bool from_cache  [新增]
        +to_dict() dict
    }

    class SourceMeta {
        +str id
        +str name
        +str origin
        +str type
        +list~str~ host_patterns
        +float default_weight
        +bool requires_token
        +bool enabled
        +bool preset
        +str path_rule
        +to_dict() dict
        +matches(host) bool
    }

    class SourceHealth {
        +str source_id
        +float ewma_latency_ms
        +float ewma_speed_mbps
        +float success_rate
        +int total_trials
        +int total_fails
        +CircuitBreaker breaker
        +float last_ok_ts
        +to_dict() dict
        +observe(probe) void
        +available() bool
    }

    class SourceRegistry {
        +dict~str,SourceMeta~ sources
        +dict~str,SourceHealth~ health
        +TTLCache probe_cache
        +str persist_path
        +add_source(meta) void
        +remove_source(id) void
        +get(id) SourceMeta
        +health_of(id) SourceHealth
        +mark_unavailable(id, reason) void
        +record_outcome(id, ok) void
        +snapshot() dict
        +load() void
        +save() void
    }

    class SourceScheduler {
        +SourceRegistry registry
        +float cache_ttl_s
        +score_source(probe, health, file_size, profile) float
        +select(urls, file_size, purpose, force) SelectionResult
        +skipped_cooling() list~str~
    }

    class SelectionResult {
        +str best_url
        +list~dict~ ranking
        +list~str~ skipped
        +bool from_cache
    }

    class CircuitBreaker {
        <<reused from hub/net.py:169>>
        +allow() bool
        +record_ok() void
        +record_fail() void
    }

    class TTLCache {
        <<reused from hub/net.py:55>>
        +get(key) Any
        +set(key, value, ttl) void
    }

    class TokenBucket {
        <<reused from hub/net.py:122>>
        +take(n) bool
    }

    SourceRegistry "1" --> "*" SourceMeta : holds
    SourceRegistry "1" --> "*" SourceHealth : tracks
    SourceHealth "1" --> "1" CircuitBreaker : reuses
    SourceRegistry "1" --> "1" TTLCache : reuses
    SourceRegistry ..> TokenBucket : reuses
    SourceScheduler --> SourceRegistry : uses
    SourceScheduler --> SourceProbe : consumes
    SourceScheduler --> SelectionResult : returns
    SourceProbe ..> SourceHealth : observe()
